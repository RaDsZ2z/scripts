[Unit]
Description=Banana Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=banana-web
Group=banana-web
WorkingDirectory=/opt/banana-web
EnvironmentFile=-/etc/banana-web/environment
ExecStart=/opt/banana-web/.venv/bin/python /opt/banana-web/app.py --port 8765 --no-browser
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
